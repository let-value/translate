{
    "name": "@let-value/graph",
    "version": "1.1.7-beta.3",
    "private": true,
    "description": "A dynamic, asynchronous DAG of computations: scoped node kinds, phase barriers over work discovered while running, and demand-driven evaluation.",
    "keywords": [
        "concurrency",
        "dag",
        "graph",
        "scheduler",
        "task-graph"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/let-value/translate"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vp pack",
        "pretest": "pnpm run build",
        "check": "vp check",
        "format": "vp fmt",
        "typecheck": "tsc --build",
        "test": "vp test"
    },
    "devDependencies": {
        "@types/node": "26.0.1",
        "typescript": "6.0.3",
        "vite-plus": "latest"
    }
}
